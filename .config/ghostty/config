theme = Kanagawabones

foreground = #fff
background = #000
background-opacity = 0.10
background-blur = 50

unfocused-split-opacity = 0.6
window-padding-x = 8

font-family = "FiraCode nerf Font Mono"
font-thicken = true
font-size = 14

minimum-contrast = 1.4
mouse-hide-while-typing = true

macos-option-as-alt = left
term = xterm-256color

keybind = super+shift+e=new_split:right
keybind = super+shift+o=new_split:down

keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right
